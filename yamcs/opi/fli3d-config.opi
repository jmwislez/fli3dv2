    <foreground_color>
      <color red="0" green="0" blue="0" />
    </foreground_color>
    <format_type>0</format_type>
    <height>20</height>
    <horizontal_alignment>2</horizontal_alignment>
    <name>Text Update_49</name>
    <precision>0</precision>
    <precision_from_pv>true</precision_from_pv>
    <pv_name />
    <pv_value />
    <rotation_angle>0.0</rotation_angle>
    <rules />
    <scale_options>
      <width_scalable>true</width_scalable>
      <height_scalable>true</height_scalable>
      <keep_wh_ratio>false</keep_wh_ratio>
    </scale_options>
    <scripts>
      <path pathString="EmbeddedJs" checkConnect="true" seoe="false">
        <scriptName>EmbeddedScript</scriptName>
        <scriptText><![CDATA[function toHex(value) {
    return ((value < 16) ? "0" : "") + value.toString(16); 
}

esp32_my_mac = toHex(Number(PVUtil.getLong(pvs[0]))) + ":" +
               toHex(Number(PVUtil.getLong(pvs[1]))) + ":" +
               toHex(Number(PVUtil.getLong(pvs[2]))) + ":" +
               toHex(Number(PVUtil.getLong(pvs[3]))) + ":" +
               toHex(Number(PVUtil.getLong(pvs[4]))) + ":" +
               toHex(Number(PVUtil.getLong(pvs[5])));

widget.setValue(esp32_my_mac.toUpperCase());]]></scriptText>
