    </scale_options>
    <scripts>
      <path pathString="EmbeddedJs" checkConnect="true" seoe="false">
        <scriptName>EmbeddedScript</scriptName>
        <scriptText><![CDATA[function padZero(value) {
    return (value < 10 ? "0" : "") + value;
}

time_string = padZero(pvs[0].getValue()) + ":" +
              padZero(pvs[1].getValue()) + ":" +
              padZero(pvs[2].getValue()) + "." +
              padZero(pvs[3].getValue());

widget.setValue(time_string);]]></scriptText>
        <pv trig="true">/fli3d/GPS_hours</pv>
        <pv trig="true">/fli3d/GPS_minutes</pv>
        <pv trig="true">/fli3d/GPS_seconds</pv>
        <pv trig="true">/fli3d/GPS_centiseconds</pv>
      </path>
    </scripts>
